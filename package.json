{
  "name": "stock-scanner",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build -w @stock-scanner/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test -c apps/web/playwright.config.ts",
    "mobile:export": "npm run export -w @stock-scanner/mobile"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "type": "module"
}
