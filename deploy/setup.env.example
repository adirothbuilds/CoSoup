# Reference only. setup.sh creates and owns your private ROOT/.env.
# Values with spaces must be quoted. Do not use export or shell substitution.
MODE=dev
COMPOSE_PROJECT_NAME=cosoup-dev
TIMEZONE=Asia/Jerusalem
BIND_ADDRESS=127.0.0.1
SERVER_PORT=8080
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8081
BROWSER_ORIGIN=http://127.0.0.1:8081
BROWSER_SECURE_COOKIE=false

# Privately provision the provider key after the first setup, then rerun it.
MASSIVE_API_KEY=''

# Generated on first setup; do not erase existing values on later runs.
API_TOKEN=''
ADMIN_DATABASE_PASSWORD=''
API_DATABASE_PASSWORD=''
SCANNER_DATABASE_PASSWORD=''
SCHEDULER_DATABASE_PASSWORD=''
STORAGE_DATABASE_PASSWORD=''
IMPORTS_DATABASE_PASSWORD=''
CODEX_DATABASE_PASSWORD=''
ARCHIVE_KEY_BASE64=''

# Optional integrations stay disabled until privately configured and verified.
R2_ENDPOINT=''
R2_BUCKET=''
R2_ACCESS_KEY=''
R2_SECRET_KEY=''
CODEX_ENABLED=false
CODEX_SANDBOX_VERIFIED=false
AUTOMATIC_ARCHIVES=false
ARCHIVE_EVICT=false

# Optional container resource overrides and storage admission settings.
# SCANNER_MEMORY=4g
# SCANNER_CPUS=2
# LIMIT_CAPACITY_BYTES=200000000000
# LIMIT_TARGET_BYTES=140000000000
# LIMIT_ARCHIVE_TRIGGER_BYTES=160000000000
# LIMIT_ADMISSION_STOP_BYTES=180000000000
